{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chaya",
  "version": "0.1.0",
  "identifier": "com.chaya.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node scripts/assemble-ui.mjs",
    "beforeBuildCommand": "node scripts/assemble-ui.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Chaya",
        "width": 1100,
        "height": 760,
        "visible": false,
        "decorations": false,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "backgroundColor": "#F6F4F0"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: chaya-file: http://chaya-file.localhost; media-src chaya-file: http://chaya-file.localhost; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Saves the videos, pictures and streams on pages you visit",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "engine/": "engine/",
      "../../../app/src/main/assets/adblock/easylist.txt": "adblock/easylist.txt",
      "../../../app/src/main/assets/adblock/easyprivacy.txt": "adblock/easyprivacy.txt"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJENjlBOERFNzQ0QzZBQUUKUldTdWFreDAzcWhwTFhlUk9NNzdWRVRheW54aE1vTGVMWW43WENKM0RHeTZJVnJ2YXJoYUt0bEoK",
      "endpoints": [
        "https://github.com/katariyaVivek/chaya/releases/download/windows-latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
